    "input-otp": "^1.4.2",
    "lucide-react": "^1.8.0",
    "next": "16.2.4",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-compare-slider": "^4.0.0",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "shadcn": "^4.3.0",
    "tailwind-merge": "^3.5.0",
